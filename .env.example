# All settings live in data/config.yaml and can be changed in the web interface (port 4883).
# Environment variables are only used for settings that are missing in config.yaml,
# e.g. to create it on the first start.

SERVER_URL=
DISCORD_TOKEN=
CRAFTY_TOKEN=
GUILD_ID=

# Optional
COMMAND_CHANNEL_ENABLED=
COMMAND_CHANNEL_ID=
CONTROL_ROLE_ENABLED=
CONTROL_ROLE_ID=
# Comma-separated server IDs available in the bot (empty = all)
ALLOWED_SERVERS=
ENABLE_AUTO_STOP_SERVER=
# Minutes after the last player left until the server is stopped (default 120)
AUTO_STOP_IDLE_MINUTES=
STATUS_ENABLED=
STATUS_CHANNEL_ID=
STATUS_UPDATE_INTERVAL=
WEB_PORT=
WEB_PASSWORD=
